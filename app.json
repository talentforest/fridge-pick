{
  "expo": {
    "name": "fridgepick",
    "slug": "fridgepick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ellie0501.fridgepick"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ddca7827-4247-4576-9d4c-c43c324c612c"
      }
    },
    "owner": "fridge-pick",
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
