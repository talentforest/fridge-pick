{
  "expo": {
    "name": "프리지픽",
    "slug": "fridgepick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app/app_icon_light.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ellie0501.fridgepick",
      "icon": {
        "light": "./assets/images/app/app_icon_light.png",
        "dark": "./assets/images/app/app_icon_dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app/app_icon_light.png",
        "backgroundColor": "#FFF8EB"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ellie0501.fridgepick"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/app/app_icon_light.png"
    },
    "extra": {
      "eas": {
        "projectId": "ddca7827-4247-4576-9d4c-c43c324c612c"
      }
    },
    "owner": "fridge-pick",
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app/splash_logo.png",
          "imageWidth": 180,
          "resizeMode": "cover",
          "backgroundColor": "#fff",
          "dark": {
            "backgroundColor": "#191C25"
          }
        }
      ]
    ]
  }
}
